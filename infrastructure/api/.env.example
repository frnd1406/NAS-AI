# NAS API Environment Variables (example)
# Replace placeholder values before running in any environment.

# === Server Configuration ===
PORT=8080
BIND_ADDR=0.0.0.0
ENV=development
LOG_LEVEL=debug

# === TLS (Transport encryption — server is TLS-only) ===
# Provide a CA-issued cert/key in production (REQUIRED there).
# If left empty in non-production, an ephemeral self-signed cert is generated
# in memory at startup (see scripts/gen-selfsigned-cert.sh for a persistent one).
TLS_CERT_FILE=
TLS_KEY_FILE=

# === Security Secrets ===
JWT_SECRET=CHANGE_ME_IN_PROD
SESSION_SECRET=CHANGE_ME_IN_PROD
CSRF_SECRET=CHANGE_ME_IN_PROD

# === CORS Configuration ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# === Frontend URL ===
FRONTEND_URL=http://localhost:5173

# === Rate Limiting ===
RATE_LIMIT_PER_MIN=100

# === Database Configuration ===
DB_HOST=localhost
DB_PORT=5433
DB_USER=nas_user
DB_PASSWORD=CHANGE_ME
DB_NAME=nas_db
# Postgres TLS: disable|require|verify-ca|verify-full.
# Defaults to "require" when ENV=production, otherwise "disable".
DB_SSLMODE=disable

# === Redis Configuration ===
REDIS_HOST=localhost
REDIS_PORT=6380
# Enable TLS to Redis against in-network sniffing.
REDIS_TLS=false
# Allow self-signed Redis certs on trusted internal networks (use with care).
REDIS_TLS_SKIP_VERIFY=false

# === WebAuthn / FIDO2 (YubiKey second factor) ===
# Optional. If unset, RP ID/origins are derived from FRONTEND_URL + CORS_ORIGINS
# (RP ID falls back to "localhost"). WebAuthn is opt-in per account: users
# without a registered key keep password-only login.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_DISPLAY_NAME=NAS.AI
# Comma-separated allowed origins (must match the web UI origin), e.g.
# https://nas.example.com
WEBAUTHN_RP_ORIGINS=

# === AI / Internal Services ===
# The API talks to the AI Knowledge Agent and Ollama with an internal shared
# secret. Switch these to https:// once those services serve TLS so the secret
# and prompts are not sent in cleartext over the network.
AI_SERVICE_URL=http://ai-knowledge-agent:5000
OLLAMA_URL=http://host.docker.internal:11434
# Accept self-signed certs for internal https:// service calls (use with care).
INTERNAL_TLS_SKIP_VERIFY=false

# === Configurable Storage Roots ===
# Whitelist for every operator-supplied filesystem path: the setup wizard's
# storage path, the backup destination and the /system/validate-path probe.
# Anything outside these roots is rejected before the API touches the disk,
# so the endpoints cannot be used to create directories in or fingerprint
# arbitrary parts of the host filesystem.
# Comma-separated list of absolute path prefixes. Subdirectories are allowed.
# Default: /mnt,/media — keep /media so externally mounted drives stay usable.
ALLOWED_STORAGE_ROOTS=/mnt,/media

# === Email Configuration (Resend) ===
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
EMAIL_FROM="NAS.AI <noreply@example.com>"

# === Cloudflare Configuration ===
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_TOKEN
CLOUDFLARE_R2_BUCKET=nas-ai-storage
